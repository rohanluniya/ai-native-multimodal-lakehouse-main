{
  "name": "multimodal-postgres-cdc-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "multimodal",
    "database.password": "${file:/opt/kafka/secrets/db.properties:password}",
    "database.dbname": "multimodal_catalog",
    "topic.prefix": "multimodal.cdc",
    "plugin.name": "pgoutput",
    "slot.name": "multimodal_cdc_slot",
    "publication.name": "multimodal_cdc_pub",
    "table.include.list": "multimodal_ops.documents,multimodal_ops.deletion_requests",
    "snapshot.mode": "initial",
    "tombstones.on.delete": "true"
  }
}
