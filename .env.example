# AI-Native Multimodal Data Lakehouse & RAG Platform — Environment Template
# Copy to `.env` for local overrides. Never commit production credentials.

LAKEHOUSE_ENV=dev
LAKEHOUSE_EXECUTION_PROFILE=local_native
LAKEHOUSE_TRANSPORT_MODE=local_wal
LAKEHOUSE_VECTOR_BACKEND=local_hybrid
LAKEHOUSE_LOCAL_DATA_DIR=.local_data
LAKEHOUSE_API_HOST=127.0.0.1
LAKEHOUSE_API_PORT=8020

# Development persona bearer tokens (override via Kubernetes Secrets in production)
RAG_ADMIN_TOKEN=dev-rag-admin-token
RAG_ENG_LEAD_TOKEN=dev-rag-eng-token
RAG_FINANCE_TOKEN=dev-rag-finance-token
RAG_PUBLIC_TOKEN=dev-rag-public-token

# Distributed Docker Compose endpoints
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe_StrongP@ss2026!
TIKA_URL=http://localhost:9998
ICEBERG_REST_URI=http://localhost:8181/catalog
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=multimodal_s3_key
S3_SECRET_ACCESS_KEY=multimodal_s3_secret_change_me
POSTGRES_USER=multimodal
POSTGRES_PASSWORD=multimodal_dev_pass
POSTGRES_DB=multimodal_catalog
OPENLINEAGE_URL=
LOG_LEVEL=INFO
