FROM python:3.12.8-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LAKEHOUSE_ENV=docker_standalone \
    LAKEHOUSE_EXECUTION_PROFILE=local_native \
    LAKEHOUSE_API_HOST=0.0.0.0 \
    LAKEHOUSE_API_PORT=8020 \
    LAKEHOUSE_SIM_PROFILE=local

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY multimodal_lakehouse ./multimodal_lakehouse
COPY schemas ./schemas
COPY services ./services
COPY apps ./apps
COPY benchmarks ./benchmarks
COPY scripts ./scripts

RUN pip install --upgrade pip && pip install .

RUN useradd --create-home --shell /bin/bash appuser && \
    mkdir -p /app/.local_data && \
    chown -R appuser:appuser /app && \
    chmod +x /app/scripts/entrypoint_standalone.sh

USER appuser
EXPOSE 8020

HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8020/health || exit 1

ENTRYPOINT ["/app/scripts/entrypoint_standalone.sh"]
